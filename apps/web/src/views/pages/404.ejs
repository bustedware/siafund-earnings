<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link href="/css/theme.css" rel="stylesheet" />
    <style>
        body {
            background-color: var(--bg-color-contrast);
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            padding: 40px;
            border-radius: 10px;
            background: var(--container-bg);
            box-shadow: var(--box-shadow);
            max-width: 500px;
        }

        h1 {
            font-size: 48px;
            color: var(--heading-color);
            margin: 0;
        }

        p {
            font-size: 18px;
            color: #666;
            margin: 10px 0 20px;
        }

        a {
            color: var(--link-color);
        }

        .error-code {
            font-size: 100px;
            font-weight: bold;
            color: var(--error-color);
            margin: 0;
        }

        .home-button {
            display: inline-block;
            padding: 12px 20px;
            font-size: 18px;
            color: white;
            background-color: var(--accent-color);
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s ease-in-out;
        }

        .home-button:hover {
            background-color: var(--accent-hover);
        }

        .subtle-text {
            font-size: 14px;
            color: var(--subtle-text-color);
            margin-top: 15px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="error-code">404</div>
        <h1>Oops! Page Not Found</h1>
        <p>The page you are looking for might have been removed or does not exist.</p>
        <a href="/" class="home-button">Go Back to Home</a>
        <p class="subtle-text">If you believe this is an error, please contact <a
                href="mailto:jbills@bustedware.com">support</a>
        </p>
    </div>
    <script src="/js/theme.js"></script>
</body>

</html>